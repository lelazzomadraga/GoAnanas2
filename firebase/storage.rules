rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function me() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }

    // scan photos: readable by signed-in users of the same farm (and administrators); uploaded by active members
    match /farms/{farm}/scans/{file} {
      allow read: if request.auth != null && (me().farmCode == farm || me().role == 'admin');
      allow write: if request.auth != null && me().farmCode == farm && me().status == 'active'
                   && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    // profile pictures
    match /avatars/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && fileName == request.auth.uid + '.jpg'
                   && request.resource.size < 4 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
  }
}
